<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ========== COLORS ========== -->
    <Color x:Key="C_White">#FFFFFFFF</Color>
    <Color x:Key="C_Black">#FF000000</Color>

    <Color x:Key="C_Bg">#FFF7FAFC</Color>
    <Color x:Key="C_Card">#FFFFFFFF</Color>

    <Color x:Key="C_Blue100">#FFE6F0FF</Color>
    <Color x:Key="C_Blue300">#FF8BB8FF</Color>
    <Color x:Key="C_Blue700">#FF165DFF</Color>
    <Color x:Key="C_Blue900">#FF0B2E6B</Color>

    <Color x:Key="C_Text">#FF0F172A</Color>
    <Color x:Key="C_SubText">#FF64748B</Color>
    <Color x:Key="C_Border">#FFE2E8F0</Color>

    <Color x:Key="C_Green500">#FF16A34A</Color>

    <!-- ========== BRUSHES ========== -->
    <SolidColorBrush x:Key="Brush.Bg" Color="{StaticResource C_Bg}" />
    <SolidColorBrush x:Key="Brush.Card" Color="{StaticResource C_Card}" />

    <SolidColorBrush x:Key="Brush.Text" Color="{StaticResource C_Text}" />
    <SolidColorBrush x:Key="Brush.SubText" Color="{StaticResource C_SubText}" />
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource C_Border}" />

    <SolidColorBrush x:Key="Brush.Blue100" Color="{StaticResource C_Blue100}" />
    <SolidColorBrush x:Key="Brush.Blue700" Color="{StaticResource C_Blue700}" />
    <SolidColorBrush x:Key="Brush.Blue900" Color="{StaticResource C_Blue900}" />

    <SolidColorBrush x:Key="Brush.Green" Color="{StaticResource C_Green500}" />

    <!-- Aliases utilisés dans certaines pages -->
    <SolidColorBrush x:Key="BgLight" Color="{StaticResource C_Bg}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource C_SubText}" />

    <!-- Gradient décoratif (bandeau) -->
    <LinearGradientBrush x:Key="Brush.TopGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{StaticResource C_Blue700}" Offset="0" />
        <GradientStop Color="{StaticResource C_Green500}" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="Brush.LineBlue" Color="{StaticResource C_Blue300}" />

</ResourceDictionary>
