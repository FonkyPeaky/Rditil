<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<SolidColorBrush x:Key="BgLight" Color="{StaticResource BackgroundLight}"/>
	<SolidColorBrush x:Key="PrimaryBlueBrush" Color="{StaticResource PrimaryBlue}"/>
	<SolidColorBrush x:Key="AccentCyanBrush" Color="{StaticResource AccentCyan}"/>
	<SolidColorBrush x:Key="SuccessGreenBrush" Color="{StaticResource SuccessGreen}"/>

	<SolidColorBrush x:Key="TextDarkBrush" Color="{StaticResource TextDark}"/>
	<SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMuted}"/>

</ResourceDictionary>
