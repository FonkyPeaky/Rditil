<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Page enter (fade + slide up) -->
    <Storyboard x:Key="EnterStoryboard">
        <DoubleAnimation Storyboard.TargetName="CardRoot"
                         Storyboard.TargetProperty="Opacity"
                         From="0" To="1" Duration="0:0:0.35" />

        <DoubleAnimation Storyboard.TargetName="CardRoot"
                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                         From="16" To="0" Duration="0:0:0.35" />
    </Storyboard>

    <!-- Card load (slightly faster) -->
    <Storyboard x:Key="FadeSlideIn">
        <DoubleAnimation Storyboard.TargetName="CardRoot"
                         Storyboard.TargetProperty="Opacity"
                         From="0" To="1" Duration="0:0:0.25" />

        <DoubleAnimation Storyboard.TargetName="CardRoot"
                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                         From="10" To="0" Duration="0:0:0.25" />
    </Storyboard>

</ResourceDictionary>
