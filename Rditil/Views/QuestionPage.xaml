<Page x:Class="Rditil.Views.QuestionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Background="{DynamicResource BackgroundBrush}">

    <Page.Resources>

        <!-- Animation "smooth" -->
        <Storyboard x:Key="CardEnter">
            <DoubleAnimation Storyboard.TargetName="Card"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.30" />
            <ThicknessAnimation Storyboard.TargetName="Card"
                                Storyboard.TargetProperty="Margin"
                                From="0,24,0,0" To="0"
                                Duration="0:0:0.30">
                <ThicknessAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </ThicknessAnimation.EasingFunction>
            </ThicknessAnimation>
        </Storyboard>

        <!-- Petit style texte -->
        <Style x:Key="HeaderLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextDarkBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="HeaderValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource CyanBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

    </Page.Resources>

    <Grid Margin="26">
        <Border x:Name="Card"
                Opacity="0"
                CornerRadius="28"
                Background="{DynamicResource CardBrush}"
                Padding="28"
                SnapsToDevicePixels="True">

            <Border.Effect>
                <!-- Shadow plus "premium" -->
                <DropShadowEffect BlurRadius="45"
                                  ShadowDepth="10"
                                  Opacity="0.25"
                                  Color="#000000"/>
            </Border.Effect>

            <Border.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard Storyboard="{StaticResource CardEnter}"/>
                </EventTrigger>
            </Border.Triggers>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="22"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="26"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- HEADER (flèches rouges) -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Gauche : Question x/40 -->
                    <TextBlock Grid.Column="0"
                               Text="{Binding QuestionHeaderText}"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextDarkBrush}"
                               VerticalAlignment="Center"/>

                    <!-- Droite : Temps restant -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Temps restant : "
                                   Style="{StaticResource HeaderLabel}"
                                   Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding TempsRestantText}"
                                   Style="{StaticResource HeaderValue}"/>
                    </StackPanel>
                </Grid>

                <!-- ENONCE -->
                <TextBlock Grid.Row="2"
                           Text="{Binding QuestionEnCours.Enonce}"
                           TextWrapping="Wrap"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextDarkBrush}"
                           Margin="0,0,0,6"/>

                <!-- LISTE DES REPONSES -->
                <ItemsControl Grid.Row="4"
                              ItemsSource="{Binding ReponsesChoix}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="18"
                                    Margin="0,0,0,14"
                                    Background="{DynamicResource AnswerBrush}"
                                    Padding="16">

                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="20"
                                                      ShadowDepth="4"
                                                      Opacity="0.18"
                                                      Color="#000000"/>
                                </Border.Effect>

                                <DockPanel LastChildFill="True">
                                    <CheckBox IsChecked="{Binding EstSelectionnee, Mode=TwoWay}"
                                              VerticalAlignment="Center"
                                              Margin="0,0,12,0"/>
                                    <TextBlock Text="{Binding TextReponse}"
                                               FontSize="16"
                                               Foreground="{DynamicResource TextDarkBrush}"
                                               TextWrapping="Wrap"/>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- BOUTON -->
                <Button Grid.Row="6"
                        Content="Suivant"
                        Command="{Binding QuestionSuivanteCommand}"
                        Width="240"
                        Height="46"
                        HorizontalAlignment="Center"
                        Background="{DynamicResource SuccessGreenBrush}"
                        Foreground="White"
                        FontSize="16"
                        FontWeight="SemiBold"
                        BorderThickness="0">
                    <Button.Effect>
                        <DropShadowEffect BlurRadius="26"
                                          ShadowDepth="6"
                                          Opacity="0.22"
                                          Color="#000000"/>
                    </Button.Effect>
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="22">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

            </Grid>
        </Border>
    </Grid>
</Page>
