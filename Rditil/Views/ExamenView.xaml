        <!-- Buttons -->
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Height" Value="54"/>
            <Setter Property="MinWidth" Value="160"/>
            <Setter Property="Padding" Value="26,14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B"
                                Background="{TemplateBinding Background}"
                                CornerRadius="14">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="18" ShadowDepth="6" Opacity="0.12"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="0,0,0,0"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.02" ScaleY="1.02"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="B" Property="Opacity" Value="0.95"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.99" ScaleY="0.99"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="B" Property="Opacity" Value="0.90"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="B" Property="Opacity" Value="0.55"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Page.Resources>

    <!-- Background -->
    <Grid>
        <!-- White base -->
        <Rectangle Fill="#F6F9FF"/>

        <!-- Blue band on the right -->
        <Rectangle HorizontalAlignment="Right" Width="380">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#EAF2FF" Offset="0"/>
                    <GradientStop Color="#2E7DFF" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- Soft blobs -->
        <Ellipse Width="560" Height="560" HorizontalAlignment="Left" VerticalAlignment="Top"
                 Margin="-260,-260,0,0" Opacity="0.25">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#2E7DFF" Offset="0"/>
                    <GradientStop Color="#002E7DFF" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
            <Ellipse.Effect>
                <BlurEffect Radius="50"/>
            </Ellipse.Effect>
        </Ellipse>

        <Ellipse Width="520" Height="520" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                 Margin="0,0,-260,-260" Opacity="0.18">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#0B2D5B" Offset="0"/>
                    <GradientStop Color="#000B2D5B" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
            <Ellipse.Effect>
                <BlurEffect Radius="60"/>
            </Ellipse.Effect>
        </Ellipse>

        <!-- Content -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid Margin="22">
                <!-- Glass card -->
                <Border Background="{StaticResource GlassWhite}"
                        BorderBrush="{StaticResource GlassBorder}"
                        BorderThickness="1"
                        CornerRadius="26"
                        Padding="34"
                        Margin="0,8,0,8">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="35" ShadowDepth="16" Opacity="0.18"/>
                    </Border.Effect>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="RD-ITIL" Style="{StaticResource TitleText}"/>
                                <TextBlock Text="Examen blanc ITIL"
                                           Style="{StaticResource SubTitleText}"
                                           Margin="2,4,0,0"/>
                            </StackPanel>

                            <!-- Timer -->
                            <Border Grid.Column="1"
                                    Style="{StaticResource TimerBadge}"
                                    VerticalAlignment="Top">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="⏱" FontSize="16" Margin="0,0,10,0"/>
                                    <TextBlock Text="{Binding TempsRestantText}"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Foreground="#101828"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Question number -->
                        <TextBlock Grid.Row="1"
                                   Text="{Binding QuestionNumeroText}"
                                   Style="{StaticResource SectionTitle}"
                                   Margin="0,18,0,0"/>

                        <!-- Question text -->
                        <TextBlock Grid.Row="2"
                                   Text="{Binding Enonce}"
                                   Style="{StaticResource QuestionText}"
                                   Margin="0,14,0,0"/>

                        <!-- Answers -->
                        <ItemsControl Grid.Row="3"
                                      Margin="0,16,0,0"
                                      ItemsSource="{Binding ReponsesChoix}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ToggleButton Style="{StaticResource AnswerToggleStyle}"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}">
                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap"/>
                                    </ToggleButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Bottom navigation -->
                        <Grid Grid.Row="4" Margin="0,28,0,0">
