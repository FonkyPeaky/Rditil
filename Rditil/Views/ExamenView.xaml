<Page x:Class="Rditil.Views.ExamenView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#EFF3F9">

    <Page.Resources>

        <!-- Animation d’apparition -->
        <Storyboard x:Key="PageEnter">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.4"/>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                             From="0.96" To="1" Duration="0:0:0.4"/>
        </Storyboard>

        <!-- Ombre douce moderne -->
        <DropShadowEffect x:Key="SoftShadow"
                          Color="#000000"
                          BlurRadius="20"
                          ShadowDepth="4"
                          Opacity="0.12"/>

        <!-- Carte blanche (question) -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="30"/>
            <Setter Property="Effect" Value="{StaticResource SoftShadow}"/>
        </Style>

        <!-- Style réponse clean + hover -->
        <Style x:Key="AnswerCard" TargetType="Border">
            <Setter Property="Background" Value="#F4F7FB"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#D8DDE5"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0 0 0 15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>

            <Style.Triggers>

                <!-- Hover (agrandissement futuriste) -->
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <ScaleTransform ScaleX="1.02" ScaleY="1.02"/>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="BorderBrush" Value="#93C5FD"/>
                </Trigger>

                <!-- Sélectionné -->
                <DataTrigger Binding="{Binding IsChoisie}" Value="True">
                    <Setter Property="Background" Value="#E0EDFF"/>
                    <Setter Property="BorderBrush" Value="#3B82F6"/>
                </DataTrigger>

            </Style.Triggers>
        </Style>

        <!-- Bouton moderne bleu -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="18 10"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="#2563EB"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16"
                                                  Color="#2563EB"
                                                  ShadowDepth="0"
                                                  Opacity="0.35"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>

                            <!-- Hover -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#1D4ED8"/>
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.03" ScaleY="1.03"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>

                            <!-- Pressed -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#1E40AF"/>
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.97" ScaleY="0.97"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>

        </Style>

    </Page.Resources>


    <!-- CONTENU PRINCIPAL -->
    <Grid Opacity="0" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <ScaleTransform ScaleX="1" ScaleY="1"/>
        </Grid.RenderTransform>

        <Grid.Triggers>
            <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard Storyboard="{StaticResource PageEnter}"/>
            </EventTrigger>
        </Grid.Triggers>

        <Grid Margin="40">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>


            <!-- HEADER -->
            <StackPanel Orientation="Vertical">

                <StackPanel Orientation="Horizontal" Margin="0 0 0 8">
                    <TextBlock Text="🧭 Examen ITIL"
                               FontSize="46"
                               FontWeight="Bold"
                               Foreground="#1E293B"/>
                </StackPanel>

                <!-- ProgressBar SIMPLE = ZERO ERREUR -->
                <ProgressBar Value="{Binding Progression}"
                             Maximum="100"
                             Height="10"
                             Background="#E2E8F0"
                             Foreground="#3B82F6"
                             Margin="0 10 0 0"/>
            </StackPanel>



            <!-- QUESTION -->
            <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0 20 0 20">

                <StackPanel>

                    <TextBlock Text="{Binding QuestionEnCours.Enonce}"
                               FontSize="28"
                               FontWeight="SemiBold"
                               Foreground="#1F2937"
                               TextWrapping="Wrap"
                               Margin="0 0 0 25"/>

                    <ItemsControl ItemsSource="{Binding ReponsesChoix}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource AnswerCard}">
                                    <RadioButton Content="{Binding TextReponse}"
                                                 IsChecked="{Binding IsChoisie, Mode=TwoWay}"
                                                 FontSize="20"
                                                 Foreground="#1E293B"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>

            </Border>


            <!-- FOOTER -->
            <StackPanel Grid.Row="2"
                        HorizontalAlignment="Right">
                <Button Content="Question suivante →"
                        Command="{Binding QuestionSuivanteCommand}"
                        Style="{StaticResource PrimaryButton}"/>
            </StackPanel>

        </Grid>
    </Grid>
</Page>
