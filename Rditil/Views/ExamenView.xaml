<Page x:Class="Rditil.Views.ExamenView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Title="Examen blanc ITIL - QCM">

    <Page.Resources>
        <LinearGradientBrush x:Key="AppGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0B1434" Offset="0"/>
            <GradientStop Color="#1B2A80" Offset="0.45"/>
            <GradientStop Color="#5B1FE2" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="28"/>
            <Setter Property="Background">
                <Setter.Value>
                    <SolidColorBrush Color="#1AFFFFFF"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Opacity="0.35" BlurRadius="24" ShadowDepth="2"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="H1" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="34"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="Body" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#F0F3FF"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="MinWidth" Value="140"/>
            <Setter Property="Padding" Value="18,6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#5B8CFF" Offset="0"/>
                        <GradientStop Color="#6C4DFF" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="12" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Page.Background>
        <StaticResource ResourceKey="AppGradient"/>
    </Page.Background>

    <Grid Margin="0">
        <!-- Header -->
        <Grid Margin="36,30,36,0" VerticalAlignment="Top">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Vertical" DockPanel.Dock="Left">
                    <TextBlock Text="R D I T I L" Style="{StaticResource H1}" />
                    <TextBlock Text="{Binding UserFullName, TargetNullValue=candidat}" Style="{StaticResource Body}" Opacity="0.85"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" DockPanel.Dock="Right">
                    <TextBlock Text="Temps restant : " Style="{StaticResource Body}" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding TempsRestantText}" FontFamily="Segoe UI" FontSize="18" FontWeight="Bold" Foreground="White"/>
                </StackPanel>
            </DockPanel>
        </Grid>

        <!-- Carte QCM -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource CardBorder}" Grid.Column="1" Width="880" Margin="0,100,0,100">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Énoncé -->
                    <TextBlock Grid.Row="0"
                               Text="{Binding QuestionEnCours.Enonce}"
                               FontFamily="Segoe UI" FontSize="20" FontWeight="SemiBold"
                               Foreground="White" TextWrapping="Wrap"/>

                    <!-- Réponses -->
                    <ItemsControl Grid.Row="2" ItemsSource="{Binding ReponsesChoix}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="10" Background="#14FFFFFF" Padding="10" Margin="0,6,0,6">
                                    <CheckBox
                                        Content="{Binding TextReponse}"
                                        IsChecked="{Binding IsChoisie, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Foreground="White"
                                        FontFamily="Segoe UI"
                                        FontSize="14"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Actions -->
                    <DockPanel Grid.Row="3" LastChildFill="False" Margin="0,16,0,0">
                        <Button Content="Suivant" Style="{StaticResource PrimaryButton}"
                                Command="{Binding QuestionSuivanteCommand}"
                                HorizontalAlignment="Right" />
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
