<Page x:Class="Rditil.Views.ExamenView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      Title="Examen"
      Background="Transparent"
      Loaded="Page_Loaded">

    <Page.Resources>

        <!-- Palette Randstad Digital -->
        <Color x:Key="RD_Blue">#2E7DFF</Color>
        <Color x:Key="RD_BlueDark">#0B2D5B</Color>
        <Color x:Key="RD_Green">#18C37E</Color>

        <SolidColorBrush x:Key="BrushBlue" Color="{StaticResource RD_Blue}"/>
        <SolidColorBrush x:Key="BrushBlueDark" Color="{StaticResource RD_BlueDark}"/>
        <SolidColorBrush x:Key="BrushGreen" Color="{StaticResource RD_Green}"/>

        <!-- Glass -->
        <SolidColorBrush x:Key="GlassWhite" Color="#CCFFFFFF"/>
        <SolidColorBrush x:Key="GlassBorder" Color="#55FFFFFF"/>

        <!-- Typography -->
        <Style x:Key="TitleText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="42"/>
            <Setter Property="FontWeight" Value="ExtraBold"/>
            <Setter Property="Foreground" Value="{StaticResource BrushBlueDark}"/>
        </Style>

        <Style x:Key="SubTitleText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#667085"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource BrushBlueDark}"/>
        </Style>

        <Style x:Key="QuestionText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#101828"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="26"/>
        </Style>

        <!-- Timer badge glass -->
        <Style x:Key="TimerBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Background" Value="#F2F6FF"/>
            <Setter Property="BorderBrush" Value="#D7E3FF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,10"/>
        </Style>

        <!-- Answer toggle: white + blue border, hover blue, checked green -->
        <Style x:Key="AnswerToggleStyle" TargetType="ToggleButton">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="18,14"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#101828"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#D7E3FF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- checkbox -->
                                <Border x:Name="Box"
                                        Width="20" Height="20"
                                        CornerRadius="6"
                                        Background="Transparent"
                                        BorderBrush="#98B7FF"
                                        BorderThickness="2"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center"/>

                                <Path x:Name="Check"
                                      Grid.Column="0"
                                      Data="M 2 10 L 7 15 L 16 4"
                                      Stroke="White"
                                      StrokeThickness="2.5"
                                      StrokeEndLineCap="Round"
                                      StrokeStartLineCap="Round"
                                      Visibility="Collapsed"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Center"/>

                                <ContentPresenter Grid.Column="1"
                                                  VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource BrushBlue}"/>
                                <Setter TargetName="Root" Property="Background" Value="#F5F9FF"/>
                            </Trigger>

                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource BrushGreen}"/>
                                <Setter TargetName="Root" Property="Background" Value="#E9FBF3"/>
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource BrushGreen}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource BrushGreen}"/>
                                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.55"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Buttons -->
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Height" Value="54"/>
            <Setter Property="MinWidth" Value="160"/>
            <Setter Property="Padding" Value="26,14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B"
                                Background="{TemplateBinding Background}"
                                CornerRadius="14">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="18" ShadowDepth="6" Opacity="0.12"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="0,0,0,0"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.02" ScaleY="1.02"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="B" Property="Opacity" Value="0.95"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.99" ScaleY="0.99"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="B" Property="Opacity" Value="0.90"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="B" Property="Opacity" Value="0.55"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Page.Resources>

    <!-- Background -->
    <Grid>
        <!-- White base -->
        <Rectangle Fill="#F6F9FF"/>

        <!-- Blue band on the right -->
        <Rectangle HorizontalAlignment="Right" Width="380">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#EAF2FF" Offset="0"/>
                    <GradientStop Color="#2E7DFF" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- Soft blobs -->
        <Ellipse Width="560" Height="560" HorizontalAlignment="Left" VerticalAlignment="Top"
                 Margin="-260,-260,0,0" Opacity="0.25">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#2E7DFF" Offset="0"/>
                    <GradientStop Color="#002E7DFF" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
            <Ellipse.Effect>
                <BlurEffect Radius="50"/>
            </Ellipse.Effect>
        </Ellipse>

        <Ellipse Width="520" Height="520" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                 Margin="0,0,-260,-260" Opacity="0.18">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#0B2D5B" Offset="0"/>
                    <GradientStop Color="#000B2D5B" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
            <Ellipse.Effect>
                <BlurEffect Radius="60"/>
            </Ellipse.Effect>
        </Ellipse>

        <!-- Content -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid Margin="22">
                <!-- Glass card -->
                <Border Background="{StaticResource GlassWhite}"
                        BorderBrush="{StaticResource GlassBorder}"
                        BorderThickness="1"
                        CornerRadius="26"
                        Padding="34"
                        Margin="0,8,0,8">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="35" ShadowDepth="16" Opacity="0.18"/>
                    </Border.Effect>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="RD-ITIL" Style="{StaticResource TitleText}"/>
                                <TextBlock Text="Examen blanc ITIL"
                                           Style="{StaticResource SubTitleText}"
                                           Margin="2,4,0,0"/>
                            </StackPanel>

                            <!-- Timer -->
                            <Border Grid.Column="1"
                                    Style="{StaticResource TimerBadge}"
                                    VerticalAlignment="Top">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="⏱" FontSize="16" Margin="0,0,10,0"/>
                                    <TextBlock Text="{Binding TempsRestantText}"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Foreground="#101828"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Question number -->
                        <TextBlock Grid.Row="1"
                                   Text="{Binding QuestionNumeroText}"
                                   Style="{StaticResource SectionTitle}"
                                   Margin="0,18,0,0"/>

                        <!-- Question text -->
                        <TextBlock Grid.Row="2"
                                   Text="{Binding Enonce}"
                                   Style="{StaticResource QuestionText}"
                                   Margin="0,14,0,0"/>

                        <!-- Answers -->
                        <ItemsControl Grid.Row="3"
                                      Margin="0,16,0,0"
                                      ItemsSource="{Binding ReponsesChoix}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ToggleButton Style="{StaticResource AnswerToggleStyle}"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}">
                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap"/>
                                    </ToggleButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Bottom navigation -->
                        <Grid Grid.Row="4" Margin="0,28,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0"
                                    Style="{StaticResource NavButton}"
                                    Background="#EAF2FF"
                                    Foreground="{StaticResource BrushBlueDark}"
                                    Content="◀ Précédent"
                                    Command="{Binding PrevQuestionCommand}"/>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource NavButton}"
                                        Background="{StaticResource BrushGreen}"
                                        Foreground="White"
                                        Content="Suivant ▶"
                                        Margin="0,0,12,0"
                                        Command="{Binding NextQuestionCommand}"/>
                            </StackPanel>

                            <Button Grid.Column="3"
                                    Style="{StaticResource NavButton}"
                                    Background="#E74C3C"
                                    Foreground="White"
                                    Content="Terminer"
                                    Command="{Binding FinishExamCommand}"/>
                        </Grid>

                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
