<Page x:Class="Rditil.Views.WelcomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      Loaded="Page_Loaded"
      Background="{DynamicResource AppBackgroundBrush}"
      FontFamily="Segoe UI" FontSize="16">

    <!-- =================== THEME / RESSOURCES =================== -->
    <Page.Resources>
        <!-- Palette -->
        <Color x:Key="BrandCyan">#05E7FF</Color>
        <Color x:Key="BrandBlue">#1357FF</Color>
        <Color x:Key="Ink">#0B0F14</Color>
        <SolidColorBrush x:Key="TitleBrush" Color="{StaticResource Ink}"/>
        <SolidColorBrush x:Key="TextBrush"  Color="#14181F"/>
        <SolidColorBrush x:Key="LoginGreenBrush" Color="#61D345"/>

        <!-- Fond -->
        <DrawingBrush x:Key="AppBackgroundBrush" Stretch="Fill">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing>
                        <GeometryDrawing.Brush>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#F7FAFF" Offset="0"/>
                                <GradientStop Color="#EDF2FF" Offset="1"/>
                            </LinearGradientBrush>
                        </GeometryDrawing.Brush>
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,1,1"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing>
                        <GeometryDrawing.Brush>
                            <RadialGradientBrush GradientOrigin="0.5,0.35" Center="0.5,0.35" RadiusX="0.9" RadiusY="0.9">
                                <GradientStop Color="#00FFFFFF" Offset="0.0"/>
                                <GradientStop Color="#14A8B2D1" Offset="1.0"/>
                            </RadialGradientBrush>
                        </GeometryDrawing.Brush>
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,1,1"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <VisualBrush x:Key="DotsBrush" TileMode="Tile" ViewportUnits="Absolute" ViewboxUnits="Absolute"
                     Viewport="0,0,18,18" Viewbox="0,0,18,18" Opacity="0.30">
            <VisualBrush.Visual>
                <Grid>
                    <Ellipse Width="2" Height="2" Fill="#BFC7D1" Margin="1"/>
                </Grid>
            </VisualBrush.Visual>
        </VisualBrush>

        <LinearGradientBrush x:Key="BrandGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="{StaticResource BrandCyan}" Offset="0"/>
            <GradientStop Color="{StaticResource BrandBlue}" Offset="1"/>
        </LinearGradientBrush>

        <!-- Cadre gradient animé -->
        <Style x:Key="AnimatedGradientBorder" TargetType="Border">
            <Setter Property="CornerRadius" Value="28"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="#FDFDFD"/>
            <Setter Property="Opacity" Value="0.85"/>
            <Setter Property="BorderThickness" Value="2.2"/>
            <Setter Property="BorderBrush">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="{StaticResource BrandCyan}" Offset="0"/>
                        <GradientStop Color="{StaticResource BrandBlue}" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="22" ShadowDepth="0" Opacity="0.22"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                            <DoubleAnimation Storyboard.TargetProperty="(Border.BorderBrush).(LinearGradientBrush.GradientStops)[0].(GradientStop.Offset)"
                                             From="0" To="1" Duration="0:0:8"/>
                            <DoubleAnimation Storyboard.TargetProperty="(Border.BorderBrush).(LinearGradientBrush.GradientStops)[1].(GradientStop.Offset)"
                                             From="1" To="0" Duration="0:0:8"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>

        <!-- Bouton néon -->
        <Style x:Key="NeonButton" TargetType="Button">
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="28,16"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="Glow" Width="220" Height="18" Opacity="0.45" IsHitTestVisible="False" VerticalAlignment="Bottom">
                                <Ellipse.Fill>
                                    <RadialGradientBrush>
                                        <GradientStop Color="#0061D345" Offset="0"/>
                                        <GradientStop Color="#4061D345" Offset="1"/>
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                            <Border x:Name="Bd" CornerRadius="28">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#74F27D" Offset="0"/>
                                        <GradientStop Color="#61D345" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.28" Color="#61D345"/>
                                </Border.Effect>
                                <Grid ClipToBounds="True">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="22,10"/>
                                    <Ellipse x:Name="Ripple" Width="0" Height="0" Opacity="0" Fill="#40FFFFFF" IsHitTestVisible="False"/>
                                </Grid>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="0.75" Duration="0:0:0.18"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="0.45" Duration="0:0:0.18"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="Button.Click">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Ripple" Storyboard.TargetProperty="Opacity" From="0.0" To="0.6" Duration="0:0:0.05"/>
                                        <DoubleAnimation Storyboard.TargetName="Ripple" Storyboard.TargetProperty="Width" To="360" Duration="0:0:0.35"/>
                                        <DoubleAnimation Storyboard.TargetName="Ripple" Storyboard.TargetProperty="Height" To="360" Duration="0:0:0.35"/>
                                        <DoubleAnimation Storyboard.TargetName="Ripple" Storyboard.TargetProperty="Opacity" To="0.0" BeginTime="0:0:0.15" Duration="0:0:0.35"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Particules -->
        <Style x:Key="Particle" TargetType="Ellipse">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Height" Value="8"/>
            <Setter Property="Fill">
                <Setter.Value>
                    <RadialGradientBrush>
                        <GradientStop Color="#60FFFFFF" Offset="0"/>
                        <GradientStop Color="#00FFFFFF" Offset="1"/>
                    </RadialGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Opacity" Value="0.0"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="0" Opacity="0.35" Color="#A0CFF5"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Entrée -->
        <Storyboard x:Key="EnterStoryboard">
            <DoubleAnimation Storyboard.TargetName="MainShell" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.45"/>
            <DoubleAnimation Storyboard.TargetName="MainShellTranslate" Storyboard.TargetProperty="Y" From="18" To="0" Duration="0:0:0.45"/>
        </Storyboard>
    </Page.Resources>

    <!-- =================== LAYOUT =================== -->
    <Grid>
        <Grid>
            <Rectangle Fill="{StaticResource AppBackgroundBrush}"/>
            <Rectangle Fill="{StaticResource DotsBrush}" Margin="0,-26,0,0"/>
        </Grid>

        <!-- Logo -->
        <Image
            d:Source="pack://application:,,,/Rditil;component/Asset/randstad_logo.png"
            Source="pack://application:,,,/Rditil;component/Asset/randstad_logo.png"
            Width="288" Height="176"
            HorizontalAlignment="Left" VerticalAlignment="Top"
            Stretch="Uniform" Margin="-56,-26,0,0" />

        <!-- Capsule gradient avec texte -->
        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,22,28,0"
        CornerRadius="34" Width="360" Height="80">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="{StaticResource BrandCyan}" Offset="0"/>
                    <GradientStop Color="{StaticResource BrandBlue}" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.40" />
            </Border.Effect>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Examen blanc ITIL"
                   Foreground="White"
                   FontSize="25"
                   FontWeight="SemiBold"
                   TextAlignment="Center"
                   HorizontalAlignment="Center" Height="32" Width="283"/>

                <TextBlock Text="Randstad Digital Luxembourg"
                   Foreground="#CCFFFFFF"
                   FontSize="12"
                   FontWeight="Normal"
                   Margin="0,2,0,0"
                   TextAlignment="Center"
                   HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>


        <!-- Particules -->
        <Canvas IsHitTestVisible="False">
            <Ellipse x:Name="P1" Style="{StaticResource Particle}" Canvas.Left="120" Canvas.Top="180"/>
            <Ellipse x:Name="P2" Style="{StaticResource Particle}" Canvas.Left="420" Canvas.Top="90"/>
            <Ellipse x:Name="P3" Style="{StaticResource Particle}" Canvas.Left="860" Canvas.Top="220"/>
            <Canvas.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard RepeatBehavior="Forever">
                            <DoubleAnimation Storyboard.TargetName="P1" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:1.2" AutoReverse="True"/>
                            <DoubleAnimation Storyboard.TargetName="P1" Storyboard.TargetProperty="(Canvas.Left)" From="80" To="180" Duration="0:0:6" AutoReverse="True"/>
                            <DoubleAnimation Storyboard.TargetName="P1" Storyboard.TargetProperty="(Canvas.Top)"  From="220" To="120" Duration="0:0:7" AutoReverse="True"/>
                            <DoubleAnimation Storyboard.TargetName="P2" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:1.6" AutoReverse="True" BeginTime="0:0:0.5"/>
                            <DoubleAnimation Storyboard.TargetName="P2" Storyboard.TargetProperty="(Canvas.Left)" From="380" To="520" Duration="0:0:8" AutoReverse="True" BeginTime="0:0:0.2"/>
                            <DoubleAnimation Storyboard.TargetName="P2" Storyboard.TargetProperty="(Canvas.Top)"  From="120" To="40" Duration="0:0:9" AutoReverse="True"/>
                            <DoubleAnimation Storyboard.TargetName="P3" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:1.4" AutoReverse="True" BeginTime="0:0:0.8"/>
                            <DoubleAnimation Storyboard.TargetName="P3" Storyboard.TargetProperty="(Canvas.Left)" From="820" To="940" Duration="0:0:7.5" AutoReverse="True"/>
                            <DoubleAnimation Storyboard.TargetName="P3" Storyboard.TargetProperty="(Canvas.Top)"  From="260" To="180" Duration="0:0:8.5" AutoReverse="True"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Canvas.Triggers>
        </Canvas>

        <!-- SHELL principal -->
        <Border x:Name="MainShell" Style="{StaticResource AnimatedGradientBorder}"
                Margin="28,135,28,28" Opacity="0">
            <Border.RenderTransform>
                <TranslateTransform x:Name="MainShellTranslate" Y="0"/>
            </Border.RenderTransform>

            <!-- Contenu -->
            <Border Background="#F7F9FC" Opacity="0.92" CornerRadius="26" ClipToBounds="True" Height="310" VerticalAlignment="Top" Margin="0,-2,0,0">
                <Grid Margin="0,-13,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="18"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="{Binding Prenom, StringFormat=Bienvenue {0} !, TargetNullValue=Bienvenue %prenom !}"
                               FontSize="46" FontWeight="Black"
                               Foreground="{StaticResource TitleBrush}"
                               TextAlignment="Center" Margin="0,28,0,0"/>

                    <StackPanel Grid.Row="3" Margin="0,12,0,0">
                        <TextBlock Text="Merci de respecter les consignes :" 
                                   FontSize="18" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                        <StackPanel Margin="0,8,0,0">
                            <TextBlock Text="•  Interdiction d’utiliser le téléphone" FontSize="17" TextAlignment="Center"/>
                            <TextBlock Text="•  Respecter le temps imparti d’une heure" FontSize="17" TextAlignment="Center" Margin="0,6,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Grid.Row="4" Margin="0,12,0,0"
                               Text="Votre responsable recevra le résultat par mail une fois le test terminé."
                               FontSize="16" TextAlignment="Center" />
                    <TextBlock Grid.Row="5" Margin="0,12,0,0"
                               Text="Le test dure une heure, quand vous vous sentez prêt, vous pouvez cliquer sur → Commencer"
                               FontSize="16" TextAlignment="Center" />

                    <Button Grid.Row="6" Content="Commencer"
                            Style="{StaticResource NeonButton}"
                            HorizontalAlignment="Center"
                            Margin="0,28,0,28"
                            Click="StartButton_Click"/>
                </Grid>
            </Border>
        </Border>
    </Grid>

    <Page.Triggers>
        <EventTrigger RoutedEvent="Page.Loaded">
            <BeginStoryboard Storyboard="{StaticResource EnterStoryboard}"/>
        </EventTrigger>
    </Page.Triggers>
</Page>
