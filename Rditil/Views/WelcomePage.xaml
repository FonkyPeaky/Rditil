<Page x:Class="Rditil.Views.WelcomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Title="Accueil - Examen blanc ITIL">

    <!-- ====== Resources (mêmes vibes que Login) ====== -->
    <Page.Resources>
        <LinearGradientBrush x:Key="AppGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0B1434" Offset="0"/>
            <GradientStop Color="#1B2A80" Offset="0.45"/>
            <GradientStop Color="#5B1FE2" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="28"/>
            <Setter Property="Background">
                <Setter.Value>
                    <SolidColorBrush Color="#1AFFFFFF"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Opacity="0.35" BlurRadius="24" ShadowDepth="2"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="H1" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="34"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style x:Key="H2" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style x:Key="Body" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#F0F3FF"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="MinWidth" Value="160"/>
            <Setter Property="Padding" Value="20,6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#5B8CFF" Offset="0"/>
                        <GradientStop Color="#6C4DFF" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="12" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ✅ Storyboard qui cible la Grid Root -->
        <Storyboard x:Key="EnterStoryboard">
            <DoubleAnimation Storyboard.TargetName="Root"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.30"/>
            <DoubleAnimation Storyboard.TargetName="Root"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                             From="0.98" To="1" Duration="0:0:0.30"/>
            <DoubleAnimation Storyboard.TargetName="Root"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                             From="0.98" To="1" Duration="0:0:0.30"/>
        </Storyboard>
    </Page.Resources>

    <!-- ====== Background ====== -->
    <Page.Background>
        <StaticResource ResourceKey="AppGradient"/>
    </Page.Background>

    <!-- ====== Content ====== -->
    <Grid x:Name="Root"
          RenderTransformOrigin="0.5,0.5"
          Opacity="0"
          Loaded="Page_Loaded">
        <Grid.RenderTransform>
            <ScaleTransform/>
        </Grid.RenderTransform>

        <!-- Header brand -->
        <Grid Margin="36,30,36,0" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="R D I T I L" Style="{StaticResource H1}" Margin="0,0,0,2"/>
                <TextBlock Text="Secure Access Portal" Style="{StaticResource Body}" Opacity="0.85"/>
            </StackPanel>
        </Grid>

        <!-- Center card -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource CardBorder}" Grid.Column="1" Width="880" Margin="0,100,0,100">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Welcome -->
                    <StackPanel Grid.Row="0">
                        <TextBlock Style="{StaticResource H2}">
                            <Run Text="Bienvenue, "/>
                            <Run Text="{Binding NomUtilisateur, TargetNullValue=candidat}"/>
                        </TextBlock>
                        <TextBlock Style="{StaticResource Body}" Margin="0,6,0,0"
                                   Text="Vous allez passer un examen blanc ITIL. Merci de lire les règles ci-dessous."/>
                    </StackPanel>

                    <Rectangle Grid.Row="2" Height="1" Fill="#2FFFFFFF"/>

                    <!-- Rules + Timer + CTA -->
                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Rules -->
                        <StackPanel Grid.Column="0" Margin="0,0,24,0">
                            <TextBlock Text="Règles de l’examen blanc ITIL" Style="{StaticResource H2}"/>
                            <StackPanel Margin="0,8,0,0">
                                <TextBlock Style="{StaticResource Body}"
                                           Text="&#x2022; 40 questions à choix multiples (une ou plusieurs réponses possibles)."/>
                                <TextBlock Style="{StaticResource Body}"
                                           Text="&#x2022; Temps imparti : 1 heure (le compte à rebours démarre au clic sur Commencer)."/>
                                <TextBlock Style="{StaticResource Body}"
                                           Text="&#x2022; Le résultat sera envoyé par e-mail à votre N+1 (copie à vous)."/>
                                <TextBlock Style="{StaticResource Body}"
                                           Text="&#x2022; Les questions s’affichent une par une. Cliquez &quot;Commencer&quot; puis &quot;Suivant&quot; pour valider."/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Static timer preview + start -->
                        <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="Durée de l’épreuve" Style="{StaticResource Body}" HorizontalAlignment="Center" Opacity="0.85"/>
                            <TextBlock Text="01:00:00" FontFamily="Segoe UI" FontSize="36" FontWeight="Bold"
                                       Foreground="White" HorizontalAlignment="Center" Margin="0,4,0,18"/>
                            <Button x:Name="StartButton"
                                    Content="Commencer"
                                    Style="{StaticResource PrimaryButton}"
                                    Click="StartButton_Click"
                                    HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <!-- Footer -->
                    <DockPanel Grid.Row="5" LastChildFill="False">
                        <TextBlock Text="Bon courage ✨" Style="{StaticResource Body}" Opacity="0.85"/>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
