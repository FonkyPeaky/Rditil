<Page x:Class="Rditil.Views.WelcomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource BgLight}">

    <Grid>
        <Border Style="{StaticResource Card}"
                Width="900"
                Opacity="0"
                Loaded="Card_Loaded"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <StackPanel HorizontalAlignment="Center">

                <TextBlock Text="Bienvenue"
                           Style="{StaticResource TitleText}"/>

                <TextBlock Text="{Binding UserFullName}"
                           FontSize="20"
                           Foreground="{StaticResource TextMutedBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,24"/>

                <TextBlock Text="Examen blanc ITIL"
                           FontSize="22"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,16"/>

                <TextBlock Text="Merci de respecter les consignes :"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8"/>

                <TextBlock Text="- Interdiction d’utiliser le téléphone
- Respecter le temps imparti d’une heure
- Votre responsable recevra le résultat par mail"
                           TextAlignment="Center"
                           Margin="0,0,0,24"/>

                <Button Content="Commencer"
                        Width="220"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding StartExamCommand}"
                        HorizontalAlignment="Center"/>

            </StackPanel>
        </Border>
    </Grid>
</Page>
