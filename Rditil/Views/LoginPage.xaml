<Page x:Class="Rditil.Views.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Loaded="Page_Loaded"
      Background="{DynamicResource AppBackgroundBrush}"
      FontFamily="Segoe UI" FontSize="16">

    <Page.Resources>
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F3F4F6"/>
        <SolidColorBrush x:Key="CardBrush" Color="White"/>
        <SolidColorBrush x:Key="TitleBrush" Color="#0B0F14"/>
        <SolidColorBrush x:Key="LabelBrush" Color="#0B0F14"/>
        <SolidColorBrush x:Key="InputBackgroundBrush" Color="#CFE5E7"/>
        <SolidColorBrush x:Key="InputForegroundBrush" Color="#0B0F14"/>
        <SolidColorBrush x:Key="PrimaryBlueBrush" Color="#2D6AF0"/>
        <SolidColorBrush x:Key="LoginGreenBrush" Color="#61D345"/>

        <VisualBrush x:Key="DotsBrush" TileMode="Tile" ViewportUnits="Absolute" ViewboxUnits="Absolute"
                     Viewport="0,0,18,18" Viewbox="0,0,18,18" Opacity="0.35">
            <VisualBrush.Visual>
                <Grid>
                    <Ellipse Width="2" Height="2" Fill="#BFC7D1" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="1"/>
                </Grid>
            </VisualBrush.Visual>
        </VisualBrush>

        <Style x:Key="RoundedTextBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource InputForegroundBrush}"/>
            <Setter Property="Background" Value="{StaticResource InputBackgroundBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border CornerRadius="24" Background="{TemplateBinding Background}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RoundedPasswordBox" TargetType="PasswordBox">
            <Setter Property="Background" Value="{StaticResource InputBackgroundBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border CornerRadius="24" Background="{TemplateBinding Background}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Background" Value="{StaticResource LoginGreenBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="28" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Storyboard x:Key="EnterStoryboard">
            <DoubleAnimation Storyboard.TargetName="Card"
                             Storyboard.TargetProperty="(UIElement.Opacity)"
                             From="0" To="1" Duration="0:0:0.35"/>
            <DoubleAnimation Storyboard.TargetName="CardTranslate"
                             Storyboard.TargetProperty="Y"
                             From="12" To="0" Duration="0:0:0.35" />
        </Storyboard>
    </Page.Resources>

    <Grid>
        <Rectangle Fill="{StaticResource DotsBrush}"/>

        <!-- Logo en haut à gauche -->
        <Image x:Name="ImgLogo"
       d:Source="/Asset/randstad_logo.png"
       Width="170" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="28,22,0,0"/>

        <!-- Pastilles en haut à droite -->
        <Image x:Name="ImgBarre"
       d:Source="/Asset/Randstad_barre.png"
       Width="160" Height="32" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,20,26,0"/>

        <!-- Cercles décoratifs -->
        <Image x:Name="ImgRond1" d:Source="/Asset/Randstad_rond.png" Width="54" Height="54" Opacity="0.45"/>
        <Image x:Name="ImgRond2" d:Source="/Asset/Randstad_rond.png" Grid.Column="2" Width="54" Height="54" Opacity="0.85"/>
        <Image x:Name="ImgRond3" d:Source="/Asset/Randstad_rond.png" Grid.Column="4" Width="54" Height="54"/>


        <Grid HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="26,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Image Source="Asset/Randstad_rond.png" Width="54" Height="54" Opacity="0.45"/>
            <Image Source="Asset/Randstad_rond.png" Grid.Column="2" Width="54" Height="54" Opacity="0.85"/>
            <Image Source="Asset/Randstad_rond.png" Grid.Column="4" Width="54" Height="54"/>
        </Grid>

        <Border x:Name="Card" Width="440" Background="{StaticResource CardBrush}"
                CornerRadius="22" Padding="28" Opacity="0"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.18"/>
            </Border.Effect>
            <Border.RenderTransform>
                <TranslateTransform x:Name="CardTranslate" Y="0"/>
            </Border.RenderTransform>

            <StackPanel>
                <TextBlock Text="Login" Foreground="{StaticResource TitleBrush}"
                           FontWeight="Bold" FontSize="28"
                           HorizontalAlignment="Center" Margin="0,0,0,18"/>

                <TextBlock Text="Adresse mail :" Foreground="{StaticResource LabelBrush}" Margin="2,0,0,6" FontWeight="SemiBold"/>
                <TextBox x:Name="EmailTextBox"
                         Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource RoundedTextBox}"
                         KeyDown="OnAnyFieldKeyDown"
                         ToolTip="Entrez votre adresse e-mail"/>

                <TextBlock Text="Mot de passe :" Foreground="{StaticResource LabelBrush}" Margin="2,16,0,6" FontWeight="SemiBold"/>
                <PasswordBox x:Name="PasswordBox"
                             Style="{StaticResource RoundedPasswordBox}"
                             KeyDown="OnAnyFieldKeyDown"
                             ToolTip="Entrez votre mot de passe"/>

                <Button Content="Connexion"
                        Click="OnLoginClick"
                        Style="{StaticResource PrimaryButton}"
                        Margin="0,22,0,0" Height="44"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
