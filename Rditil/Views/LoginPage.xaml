<Page x:Class="Rditil.Views.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:sys="clr-namespace:System;assembly=mscorlib"
      mc:Ignorable="d"
      Loaded="Page_Loaded">

    <Page.Resources>

        <!-- Dégradé d’arrière-plan -->
        <LinearGradientBrush x:Key="GradientBg" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0A071E" Offset="0"/>
            <GradientStop Color="#0B1C41" Offset="0.25"/>
            <GradientStop Color="#371B6D" Offset="0.65"/>
            <GradientStop Color="#5E1AA5" Offset="1"/>
        </LinearGradientBrush>

        <DropShadowEffect x:Key="SoftShadow" Color="#000000"
                          BlurRadius="25" ShadowDepth="0" Opacity="0.35"/>

        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- TextBox arrondie + watermark (Tag) -->
        <Style TargetType="TextBox" x:Key="RoundedTextBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <Border x:Name="Bd" Background="#25FFFFFF" CornerRadius="10"
                                    Padding="12" BorderThickness="1" BorderBrush="#30FFFFFF" />
                            <ScrollViewer x:Name="PART_ContentHost"/>
                            <TextBlock x:Name="Watermark"
                                       Text="{TemplateBinding Tag}"
                                       Foreground="#80FFFFFF"
                                       Margin="14,0,0,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#70B6A3FF"/>
                                <Setter TargetName="Bd" Property="Background" Value="#35FFFFFF"/>
                            </Trigger>
                            <!-- Affiche le placeholder quand le texte est vide -->
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Watermark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- PasswordBox arrondi + watermark (disparaît au focus) -->
        <Style TargetType="PasswordBox" x:Key="RoundedPasswordBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Grid>
                            <Border x:Name="Bd" Background="#25FFFFFF" CornerRadius="10"
                                    Padding="12" BorderThickness="1" BorderBrush="#30FFFFFF"/>
                            <ScrollViewer x:Name="PART_ContentHost"/>
                            <TextBlock x:Name="Watermark"
                                       Text="{TemplateBinding Tag}"
                                       Foreground="#80FFFFFF"
                                       Margin="14,0,0,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#70B6A3FF"/>
                                <Setter TargetName="Bd" Property="Background" Value="#35FFFFFF"/>
                                <Setter TargetName="Watermark" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Bouton gradient avec petite anim -->
        <Style TargetType="Button" x:Key="PrimaryButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="scale" ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>

                            <Border x:Name="Bg" CornerRadius="14">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#6B8CFF" Offset="0"/>
                                        <GradientStop Color="#8E4BFF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="18" ShadowDepth="0"
                                                      Color="#551A86FF" Opacity="0.6"/>
                                </Border.Effect>
                            </Border>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="scale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1.03" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="scale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1.03" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="scale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="scale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Bouton “lien” -->
        <Style TargetType="Button" x:Key="LinkButton">
            <Setter Property="Foreground" Value="#CFE0FF"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock TextDecorations="Underline"
                                   Foreground="{TemplateBinding Foreground}"
                                   Text="{TemplateBinding Content}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Fade + slide-in au chargement -->
        <Storyboard x:Key="EnterStoryboard">
            <DoubleAnimation Storyboard.TargetName="Card"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.35"/>
            <DoubleAnimation Storyboard.TargetName="CardTranslate"
                             Storyboard.TargetProperty="Y"
                             From="12" To="0" Duration="0:0:0.35"/>
        </Storyboard>
    </Page.Resources>

    <!-- le Grid porte le gradient -->
    <Grid Background="{StaticResource GradientBg}">
        <!-- Header -->
        <StackPanel HorizontalAlignment="Center" Margin="0,60,0,0">
            <TextBlock Text="R D I T I L"
                       FontSize="36"
                       FontWeight="Black"
                       Foreground="White"/>
            <TextBlock Text="Secure Access Portal"
                       Foreground="#B0C3FF"
                       FontSize="12"
                       HorizontalAlignment="Center"
                       Margin="0,6,0,20"/>
        </StackPanel>

        <!-- Carte -->
        <Border x:Name="Card"
                Width="520"
                Padding="28"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                CornerRadius="18"
                Background="#30FFFFFF"
                Effect="{StaticResource SoftShadow}"
                RenderTransformOrigin="0.5,0.5"
                Opacity="0">
            <Border.RenderTransform>
                <TranslateTransform x:Name="CardTranslate" Y="12"/>
            </Border.RenderTransform>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Sign in" FontSize="24" FontWeight="Bold"
                           Foreground="White" Margin="2,2,0,20"/>

                <!-- Email -->
                <StackPanel Grid.Row="1" Margin="0,0,0,10">
                    <TextBlock Text="Email" Foreground="#CFE0FF" FontSize="12" Margin="4,0,0,6"/>
                    <TextBox Style="{StaticResource RoundedTextBox}"
                             Tag="you@company.com"
                             Text="{Binding Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             KeyDown="OnAnyFieldKeyDown"/>
                </StackPanel>

                <!-- Password -->
                <StackPanel Grid.Row="2" Margin="0,0,0,10">
                    <TextBlock Text="Password" Foreground="#CFE0FF" FontSize="12" Margin="4,0,0,6"/>
                    <PasswordBox x:Name="PasswordBox"
                                 Style="{StaticResource RoundedPasswordBox}"
                                 Tag="••••••••"
                                 KeyDown="OnAnyFieldKeyDown"/>
                </StackPanel>

                <!-- remember + links + bouton -->
                <Grid Grid.Row="3" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox Content="Remember me"
                                  Foreground="#E6FFFFFF"
                                  IsChecked="{Binding RememberMe, Mode=TwoWay}"
                                  VerticalAlignment="Center"/>
                        <TextBlock Text="  " Width="10"/>
                        <Button Style="{StaticResource LinkButton}"
                                Content="Forgot?"
                                Command="{Binding ForgotPasswordCommand}"/>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Width="140"
                            Height="40"
                            Content="Login"
                            Style="{StaticResource PrimaryButton}"
                            Click="OnLoginClick"/>
                </Grid>

                <!-- Footer -->
                <StackPanel Grid.Row="4" Margin="0,18,0,0"
                            Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Style="{StaticResource LinkButton}"
                            Content="Create account"
                            Command="{Binding CreateAccountCommand}"/>
                </StackPanel>

                <!-- Overlay “busy” : Collapsed par défaut -->
                <Grid x:Name="BusyOverlay" Background="#66000000">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBusy, TargetNullValue=False}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <Border CornerRadius="12" Padding="16" Background="#22FFFFFF"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel>
                            <ProgressBar IsIndeterminate="True" Width="200" Height="6"/>
                            <TextBlock Text="Signing you in..." Foreground="White"
                                       Margin="0,10,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- Copyright -->
        <TextBlock Text="© 2025 Rditil - Randstad Digital LU"
                   Foreground="#8FB0FF" FontSize="11"
                   HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,24"/>
    </Grid>
</Page>
