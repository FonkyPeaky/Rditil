<UserControl x:Class="Rditil.Views.Controls.RingProgress"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="root"
             Width="110"
             Height="110">

    <Grid>
        <Ellipse Stroke="{Binding TrackStroke, ElementName=root}"
                 StrokeThickness="{Binding RingThickness, ElementName=root}"
                 Opacity="0.25"/>

        <!-- Progress -->
        <Path x:Name="ArcPath"
              Stroke="{Binding RingStroke, ElementName=root}"
              StrokeThickness="{Binding RingThickness, ElementName=root}"
              StrokeStartLineCap="Round"
              StrokeEndLineCap="Round"/>

        <!-- Center -->
        <ContentPresenter Content="{Binding CenterContent, ElementName=root}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"/>
    </Grid>
</UserControl>
