<Window x:Class="Rditil.Views.EndPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rditil – Résultats"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Width="720" Height="460"
        Loaded="Window_Loaded">

    <Window.Resources>
        <!-- Dégradé clair (même palette que l’AdminPanel) -->
        <LinearGradientBrush x:Key="GradientBg" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F0F8FF" Offset="0"/>
            <GradientStop Color="#D6E9FF" Offset="1"/>
        </LinearGradientBrush>

        <DropShadowEffect x:Key="SoftShadow" Color="#000000"
                          BlurRadius="18" ShadowDepth="0" Opacity="0.25"/>

        <!-- Bouton primaire bleu -->
        <Style TargetType="Button" x:Key="PrimaryButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="10" Background="#3A8DFF" Padding="12,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1E70E8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Bouton secondaire blanc bordé -->
        <Style TargetType="Button" x:Key="SecondaryButton" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Foreground" Value="#1E70E8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="10" Background="White" Padding="12,8"
                                BorderBrush="#1E70E8" BorderThickness="1.2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Animation d’entrée -->
        <Storyboard x:Key="EnterStoryboard">
            <DoubleAnimation Storyboard.TargetName="Card"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.4"/>
            <DoubleAnimation Storyboard.TargetName="CardTranslate"
                             Storyboard.TargetProperty="Y"
                             From="15" To="0" Duration="0:0:0.4"/>
        </Storyboard>
    </Window.Resources>

    <!-- ⬇️ on met le gradient sur le Grid, pas sur la Window -->
    <Grid Background="{StaticResource GradientBg}">
        <!-- Carte centrale -->
        <Border x:Name="Card"
                Width="560"
                Padding="28"
                CornerRadius="16"
                Background="White"
                Effect="{StaticResource SoftShadow}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Opacity="0"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <TranslateTransform x:Name="CardTranslate" Y="15"/>
            </Border.RenderTransform>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0" Margin="0,0,0,12">
                    <TextBlock Text="🎉 Bravo !" FontSize="24" FontWeight="Bold" Foreground="#003366"/>
                    <TextBlock Text="Voici le récapitulatif de votre session."
                               Foreground="#5A6B84" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Contenu : à binder à ton VM -->
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
                        <TextBlock Text="Nom :" Width="140" Foreground="#6A7A90"/>
                        <TextBlock Text="{Binding Utilisateur.Nom}" FontWeight="SemiBold" Foreground="#003366"/>
                        <TextBlock Text=" " />
                        <TextBlock Text="{Binding Utilisateur.Prenom}" FontWeight="SemiBold" Foreground="#003366"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="0,4,0,8">
                        <TextBlock Text="Score :" Width="140" Foreground="#6A7A90"/>
                        <TextBlock Text="{Binding Score}" FontWeight="SemiBold" Foreground="#003366"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Grid.Row="2" Margin="0,4,0,8">
                        <TextBlock Text="Dernier examen :" Width="140" Foreground="#6A7A90"/>
                        <TextBlock Text="{Binding DernierExamen, StringFormat={}{0:dd/MM/yyyy HH:mm}}"
                                   FontWeight="SemiBold" Foreground="#003366"/>
                    </StackPanel>
                </Grid>

                <!-- Actions (sans Spacing en WPF) -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                    <Button Content="Fermer" Style="{StaticResource SecondaryButton}"
                            Click="Quitter_Click" Margin="0,0,10,0"/>
                    <Button Content="Refaire un test" Style="{StaticResource PrimaryButton}"
                            Command="{Binding RestartCommand}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
