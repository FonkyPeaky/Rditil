<Page x:Class="Rditil.Views.EndPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Résultat">

    <Page.Resources>
        <LinearGradientBrush x:Key="AppGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0B1434" Offset="0"/>
            <GradientStop Color="#1B2A80" Offset="0.45"/>
            <GradientStop Color="#5B1FE2" Offset="1"/>
        </LinearGradientBrush>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="28"/>
            <Setter Property="Background" >
                <Setter.Value>
                    <SolidColorBrush Color="#1AFFFFFF"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Opacity="0.35" BlurRadius="24" ShadowDepth="2"/>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="H1" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="34"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="Body" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#F0F3FF"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Page.Resources>

    <Page.Background>
        <StaticResource ResourceKey="AppGradient"/>
    </Page.Background>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="1" Style="{StaticResource Card}" Width="700" Margin="0,120,0,120">
            <StackPanel>
                <TextBlock Text="{Binding Title}" Style="{StaticResource H1}" Margin="0,0,0,6"/>
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Body}" Margin="0,0,0,18"/>
                <Separator/>
                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <TextBlock Text="Score : " Style="{StaticResource Body}" Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding ScoreText}" FontSize="20" FontWeight="Bold" Foreground="White"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock Text="Temps utilisé : " Style="{StaticResource Body}" Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding TimeUsedText}" FontSize="16" Foreground="White"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Page>
