<Page x:Class="Rditil.Views.EndPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Title="EndPage">

    <Page.Resources>
        <!-- Ombre utilisée par les cartes -->
        <DropShadowEffect x:Key="CardShadow"
                          Color="#000000"
                          BlurRadius="25"
                          ShadowDepth="6"
                          Opacity="0.20" />

        <!-- Style bouton arrondi (WPF Button n'a pas CornerRadius) -->
        <Style x:Key="RoundedButton" TargetType="Button">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="24,10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Height" Value="46" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="23"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid>
        <Border CornerRadius="32" Padding="40" Background="White" Effect="{DynamicResource CardShadow}" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="900">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel>
                    <TextBlock Text="RDITIL" FontSize="44" FontWeight="Black"/>
                    <TextBlock Text="Fin d'examen" FontSize="16" Opacity="0.7" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Content -->
                <Grid Grid.Row="1" Margin="0,24,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Résumé" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>

                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="Utilisateur : " FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding UserFullName}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="Email : " FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding UserEmail}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="Score : " FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding ScoreText}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="Durée : " FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding DurationText}"/>
                        </StackPanel>

                        <TextBlock Text="Statut" FontSize="18" FontWeight="SemiBold" Margin="0,22,0,8"/>
                        <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Envoi au N+1" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>

                        <TextBlock Text="Email du N+1" Opacity="0.7"/>
                        <TextBox Text="{Binding ManagerEmail, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,14"/>

                        <TextBlock Text="Contenu du mail" Opacity="0.7"/>
                        <TextBox Text="{Binding MailBody, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,14" AcceptsReturn="True" Height="180" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>

                        <Button Content="Envoyer"
                                Command="{Binding SendReportCommand}"
                                Style="{StaticResource RoundedButton}"
                                Height="44"
                                Background="#67D665"
                                Foreground="White"
                                BorderThickness="0"
                                FontWeight="SemiBold"/>
                    </StackPanel>
                </Grid>

                <!-- Footer -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0">
                    <Button Content="Retour accueil"
                            Command="{Binding GoHomeCommand}"
                            Style="{StaticResource RoundedButton}"
                            Height="44"
                            Padding="24,0"
                            Background="#EEF6FF"
                            Foreground="#0B1F33"
                            BorderThickness="0"
                            FontWeight="SemiBold"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
