<Page x:Class="Rditil.Views.EndPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Background="Transparent">

    <Page.Resources>
        <!-- Randstad Digital palette -->
        <Color x:Key="RD_Blue">#2E7DFF</Color>
        <Color x:Key="RD_BlueDark">#0B2D5B</Color>
        <Color x:Key="RD_Green">#18C37E</Color>

        <SolidColorBrush x:Key="BrushBlue" Color="{StaticResource RD_Blue}"/>
        <SolidColorBrush x:Key="BrushBlueDark" Color="{StaticResource RD_BlueDark}"/>
        <SolidColorBrush x:Key="BrushGreen" Color="{StaticResource RD_Green}"/>

        <!-- Glass -->
        <SolidColorBrush x:Key="GlassWhite" Color="#CCFFFFFF"/>
        <SolidColorBrush x:Key="GlassBorder" Color="#55FFFFFF"/>

        <!-- Text styles -->
        <Style x:Key="HeroTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="44"/>
            <Setter Property="FontWeight" Value="ExtraBold"/>
            <Setter Property="Foreground" Value="{StaticResource BrushBlueDark}"/>
            <Setter Property="LineHeight" Value="52"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="SubText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#667085"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="22"/>
        </Style>

        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#667085"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="ValueText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="#101828"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <!-- Glass card style (used with Card_Loaded animation) -->
        <Style x:Key="GlassCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource GlassWhite}"/>
            <Setter Property="BorderBrush" Value="{StaticResource GlassBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="26"/>
            <Setter Property="Padding" Value="22"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TranslateTransform Y="18"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Buttons -->
        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="Height" Value="46"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="16">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="20" ShadowDepth="8" Opacity="0.16"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Opacity" Value="0.95"/>
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.03" ScaleY="1.03"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="B" Property="Opacity" Value="0.90"/>
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.99" ScaleY="0.99"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="B" Property="Opacity" Value="0.55"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== ULTRA GIGA TABLE STYLE ===== -->
        <SolidColorBrush x:Key="TblBg" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="TblHeaderBg" Color="#F3F6FF"/>
        <SolidColorBrush x:Key="TblBorder" Color="#E2E8FF"/>
        <SolidColorBrush x:Key="TblText" Color="#0B2D5B"/>
        <SolidColorBrush x:Key="TblSubText" Color="#667085"/>

        <Style x:Key="UltraDataGrid" TargetType="{x:Type DataGrid}">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="CanUserSortColumns" Value="True"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="Background" Value="{StaticResource TblBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource TblBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowHeight" Value="46"/>
            <Setter Property="ColumnHeaderHeight" Value="46"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TblText}"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        </Style>

        <Style TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="Background" Value="{StaticResource TblHeaderBg}"/>
            <Setter Property="Foreground" Value="{StaticResource TblText}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderBrush" Value="{StaticResource TblBorder}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="12,0"/>
        </Style>

        <Style TargetType="{x:Type DataGridRow}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F7F9FF"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#EEF4FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="{x:Type DataGridCell}">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Animation used by EndPage.xaml.cs Card_Loaded -->
        <Storyboard x:Key="FadeSlideIn">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.45">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                             From="18" To="0" Duration="0:0:0.55">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Page.Resources>

    <Grid>
        <!-- Background white + blue band + soft motifs -->
        <Rectangle Fill="#F6F9FF"/>

        <Rectangle HorizontalAlignment="Right" Width="520">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#EEF4FF" Offset="0"/>
                    <GradientStop Color="#2E7DFF" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Ellipse Width="620" Height="620"
                 HorizontalAlignment="Left" VerticalAlignment="Top"
                 Margin="-290,-300,0,0" Opacity="0.22">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#2E7DFF" Offset="0"/>
                    <GradientStop Color="#002E7DFF" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
            <Ellipse.Effect>
                <BlurEffect Radius="55"/>
            </Ellipse.Effect>
        </Ellipse>

        <Ellipse Width="520" Height="520"
                 HorizontalAlignment="Right" VerticalAlignment="Bottom"
                 Margin="0,0,-260,-260" Opacity="0.14">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#0B2D5B" Offset="0"/>
                    <GradientStop Color="#000B2D5B" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
            <Ellipse.Effect>
                <BlurEffect Radius="65"/>
            </Ellipse.Effect>
        </Ellipse>

        <Grid Margin="26">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="540"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT hero (inchangé) -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center">

                <Border Background="#EAF2FF" BorderBrush="#D7E3FF" BorderThickness="1"
                        CornerRadius="999" Padding="12,6" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="✨" FontSize="14" Margin="0,0,8,0"/>
                        <TextBlock Text="Examen terminé"
                                   FontSize="13"
                                   Foreground="{StaticResource BrushBlueDark}"
                                   FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>

                <TextBlock Style="{StaticResource HeroTitle}" Margin="0,18,0,0">
                    <Run Text="Score : " />
                    <Run Text="{Binding ScoreText}" Foreground="{StaticResource BrushBlue}"/>
                </TextBlock>

                <TextBlock Style="{StaticResource SubText}" Margin="0,10,0,0"
                           Text="Ton rapport est prêt. Envoi automatique au N+1 en cours…" />

                <!-- Main action: Send mail -->
                <Button Command="{Binding SendAndCloseCommand}"
                        Margin="0,22,0,0"
                        IsEnabled="{Binding IsEmailButtonEnabled}"
                        Content="{Binding EmailButtonText}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PillButton}">
                            <Setter Property="Background" Value="{StaticResource BrushGreen}"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding EmailState}" Value="Sending">
                                    <Setter Property="Background" Value="{StaticResource BrushBlue}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding EmailState}" Value="Failed">
                                    <Setter Property="Background" Value="#EF4444"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding EmailState}" Value="Sent">
                                    <Setter Property="Background" Value="{StaticResource BrushGreen}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

<!-- Status -->
                <TextBlock Style="{StaticResource SubText}"
                           Margin="2,12,0,0"
                           Text="{Binding StatusText}"/>

                <TextBlock Style="{StaticResource SubText}" Margin="0,18,0,0"
                           Text="Tip : vise la régularité. Un petit examen souvent > un gros examen rarement."/>
            </StackPanel>

            <!-- RIGHT cards -->
            <Grid Grid.Column="1" VerticalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Summary -->
                    <RowDefinition Height="16"/>
                    <!-- spacing -->
                    <RowDefinition Height="*"/>
                    <!-- Details -->
                </Grid.RowDefinitions>

                <!-- Summary -->
                <Border Grid.Row="0" Style="{StaticResource GlassCard}" Loaded="Card_Loaded">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="👤 Utilisateur" FontSize="16" FontWeight="Bold" Foreground="{StaticResource BrushBlueDark}"/>
                            <TextBlock Text="{Binding UserFullName}" Margin="0,8,0,0" Style="{StaticResource ValueText}"/>
                            <TextBlock Text="{Binding UserEmail}" Foreground="#475467" Margin="0,4,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="⏱ Durée" FontSize="16" FontWeight="Bold" Foreground="{StaticResource BrushBlueDark}"/>
                            <TextBlock Text="{Binding DurationText}" Margin="0,8,0,0" Style="{StaticResource ValueText}"/>

                            <TextBlock Text="📩 N+1" Margin="0,14,0,0" Style="{StaticResource LabelText}"/>
                            <TextBlock Text="{Binding ManagerEmail}" Foreground="#475467" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- DETAILS -->
                <Border Grid.Row="2"
            Style="{StaticResource GlassCard}"
            Loaded="Card_Loaded"
            VerticalAlignment="Stretch">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <!-- Header -->
                            <RowDefinition Height="14"/>
                            <RowDefinition Height="*"/>
                            <!-- Table -->
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="📌 Détails"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="{StaticResource BrushBlueDark}"/>
                                <TextBlock Text="Résumé des questions et des choix (sans vrai/faux)."
                               Foreground="#667085"
                               Margin="0,6,0,0"/>
                            </StackPanel>

                            <Border Grid.Column="1"
                        Background="#101828"
                        CornerRadius="14"
                        Padding="10,8"
                        Opacity="0.95"
                        VerticalAlignment="Center">
                                <TextBlock Text="📄" FontSize="16"/>
                            </Border>
                        </Grid>

                        <Border Grid.Row="2"
                    Background="#FFFFFF"
                    BorderBrush="#E6ECFF"
                    BorderThickness="1"
                    CornerRadius="18"
                    Padding="0">

                            <!-- IMPORTANT: le DataGrid ne grandit plus, il prend la place dispo et scroll -->
                            <DataGrid Style="{StaticResource UltraDataGrid}"
                          ItemsSource="{Binding ReportRows}"
                          VerticalAlignment="Stretch">

                                <DataGrid.Columns>

                                    <!-- # -->
                                    <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="52"/>

                                    <!-- Question -->
                                    <DataGridTemplateColumn Header="Question" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Enonce}"
                                               Foreground="{StaticResource TblText}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Enonce}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- Choix -->
                                    <DataGridTemplateColumn Header="Choix" Width="280">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding ChosenText}"
                                               Foreground="{StaticResource TblSubText}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding ChosenText}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

        </Grid>

        <!-- Confirmation popup -->
        <Border Background="#CC101828"
                CornerRadius="20"
                Padding="18"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,26,0,0">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Opacity" Value="0"/>
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ShowConfirmationPopup}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Setter Property="Opacity" Value="1"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="✅" FontSize="16" Margin="0,0,10,0"/>
                <TextBlock Text="Email envoyé ! Fermeture dans "
                           Foreground="White"
                           FontWeight="SemiBold"/>
                <TextBlock Text="{Binding CloseCountdown}"
                           Foreground="{StaticResource BrushGreen}"
                           FontWeight="ExtraBold"
                           Margin="4,0,4,0"/>
                <TextBlock Text="s"
                           Foreground="White"
                           FontWeight="SemiBold"/>
            </StackPanel>
        </Border>

    </Grid>
</Page>
