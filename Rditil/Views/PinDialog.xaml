<Window x:Class="Rditil.Views.PinDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Accès admin"
        Width="720"
        Height="480"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <Window.Resources>
        <Color x:Key="RD_NavyDeep">#0B1236</Color>
        <Color x:Key="RD_Blue">#2F6DFF</Color>
        <Color x:Key="RD_Green">#18C37E</Color>

        <SolidColorBrush x:Key="BrushNavyDeep" Color="{StaticResource RD_NavyDeep}"/>
        <SolidColorBrush x:Key="BrushBlue" Color="{StaticResource RD_Blue}"/>
        <SolidColorBrush x:Key="BrushGreen" Color="{StaticResource RD_Green}"/>
        <SolidColorBrush x:Key="Muted" Color="#667085"/>

        <SolidColorBrush x:Key="GlassBg" Color="#CCFFFFFF"/>
        <SolidColorBrush x:Key="GlassStroke" Color="#55FFFFFF"/>

        <LinearGradientBrush x:Key="BgGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F6F9FF" Offset="0"/>
            <GradientStop Color="#EEF4FF" Offset="0.5"/>
            <GradientStop Color="#DDEBFF" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="14">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="18" ShadowDepth="8" Opacity="0.16"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Opacity" Value="0.95"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="B" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="B" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernInput" TargetType="Control">
            <Setter Property="Height" Value="44"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#D7E3FF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,0"/>
        </Style>

        <!-- Separator: fine + glow -->
        <LinearGradientBrush x:Key="SepGlow" StartPoint="0,0" EndPoint="0,5">
            <GradientStop Color="#00FFFFFF" Offset="0"/>
            <GradientStop Color="#22FFFFFF" Offset="0.5"/>
            <GradientStop Color="#00FFFFFF" Offset="1"/>
        </LinearGradientBrush>

        <!-- ===== Appear animation: fade + scale + micro slide ===== -->
        <Storyboard x:Key="AppearStoryboard">
            <DoubleAnimation Storyboard.TargetName="AnimRoot"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.22">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <DoubleAnimation Storyboard.TargetName="AnimScale"
                             Storyboard.TargetProperty="ScaleX"
                             From="0.96" To="1" Duration="0:0:0.26">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <DoubleAnimation Storyboard.TargetName="AnimScale"
                             Storyboard.TargetProperty="ScaleY"
                             From="0.96" To="1" Duration="0:0:0.26">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <DoubleAnimation Storyboard.TargetName="AnimTranslate"
                             Storyboard.TargetProperty="Y"
                             From="10" To="0" Duration="0:0:0.26">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>

    <!-- Start animation on load -->
    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard Storyboard="{StaticResource AppearStoryboard}"/>
        </EventTrigger>
    </Window.Triggers>

    <!-- Fond + ombre -->
    <Border x:Name="AnimRoot"
            CornerRadius="24"
            Background="{StaticResource BgGradient}"
            SnapsToDevicePixels="True"
            Opacity="0"
            RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="AnimScale" ScaleX="0.96" ScaleY="0.96"/>
                <TranslateTransform x:Name="AnimTranslate" Y="10"/>
            </TransformGroup>
        </Border.RenderTransform>

        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="18" Opacity="0.25"/>
        </Border.Effect>

        <!-- Carte -->
        <Border Margin="14"
                CornerRadius="22"
                Background="{StaticResource GlassBg}"
                BorderBrush="{StaticResource GlassStroke}"
                BorderThickness="1">

            <Grid Margin="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Accès super admin"
                                   FontSize="18"
                                   FontWeight="ExtraBold"
                                   Foreground="{StaticResource BrushNavyDeep}"/>
                        <TextBlock Text="Connecte-toi par QR code ou par code PIN."
                                   Foreground="{StaticResource Muted}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Width="36" Height="36"
                            Background="#10FFFFFF"
                            BorderThickness="1"
                            BorderBrush="#22FFFFFF"
                            Cursor="Hand"
                            Click="Cancel_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border CornerRadius="12"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}">
                                    <TextBlock Text="✕"
                                               FontSize="14"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource BrushNavyDeep}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- Content -->
                <Grid Grid.Row="1" Margin="0,14,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="26"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- QR -->
                    <Border Grid.Column="0"
                            CornerRadius="18"
                            Background="#10FFFFFF"
                            BorderBrush="#22FFFFFF"
                            BorderThickness="1"
                            Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Connexion QR"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource BrushNavyDeep}"
                                       FontSize="14"/>

                            <Border Grid.Row="1"
                                    Margin="0,12,0,12"
                                    CornerRadius="18"
                                    Background="#FFFFFF"
                                    BorderBrush="#E6ECFF"
                                    BorderThickness="1"
                                    Padding="14"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                <Grid Width="190" Height="190">
                                    <Image Source="pack://application:,,,/Rditil;component/Resources/QR_code_code_pin.png"
                                           Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           SnapsToDevicePixels="True"/>
                                </Grid>
                            </Border>

                            <TextBlock Grid.Row="2"
                                       Text=""
                                       Foreground="{StaticResource Muted}"
                                       FontSize="12"
                                       TextAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Separator -->
                    <Grid Grid.Column="1" VerticalAlignment="Stretch">
                        <Rectangle Width="1" HorizontalAlignment="Center" Fill="#1AFFFFFF"/>
                        <Rectangle Width="12" HorizontalAlignment="Center" Fill="{StaticResource SepGlow}" Opacity="0.35"/>
                    </Grid>

                    <!-- PIN -->
                    <Border Grid.Column="2"
                            CornerRadius="18"
                            Background="#10FFFFFF"
                            BorderBrush="#22FFFFFF"
                            BorderThickness="1"
                            Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Connexion PIN"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource BrushNavyDeep}"
                                       FontSize="14"/>

                            <TextBlock Grid.Row="1"
                                       Margin="0,6,0,0"
                                       Text="Entre le code PIN admin."
                                       Foreground="{StaticResource Muted}"
                                       FontSize="12"/>

                            <PasswordBox x:Name="PinBox"
                                         Grid.Row="2"
                                         Margin="0,12,0,0"
                                         Style="{StaticResource ModernInput}"/>

                            <StackPanel Grid.Row="3" Margin="0,10,0,0">
                                <TextBlock x:Name="ErrorText"
                                           Foreground="#E74C3C"
                                           TextWrapping="Wrap"
                                           FontSize="12"/>

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            Margin="0,14,25,0">
                                    <Button Content="Annuler"
                                            Width="110"
                                            Margin="0,0,10,0"
                                            Background="#EAF2FF"
                                            Foreground="{StaticResource BrushNavyDeep}"
                                            Style="{StaticResource PillButton}"
                                            Click="Cancel_Click"
                                            IsCancel="True"/>

                                    <Button Content="Valider"
                                            Width="110"
                                            Background="{StaticResource BrushBlue}"
                                            Foreground="White"
                                            Style="{StaticResource PillButton}"
                                            Click="Ok_Click"
                                            IsDefault="True"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <TextBlock Grid.Row="2"
                           Text="QR code : Panel Admin simple, intuitif et inspirante "
                           Foreground="{StaticResource Muted}"
                           FontSize="12"
                           Margin="2,0,0,0"/>
            </Grid>
        </Border>
    </Border>
</Window>
