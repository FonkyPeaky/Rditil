<Page x:Class="Rditil.Views.AdminPanel"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Loaded="Page_Loaded">

    <Page.Resources>
        <!-- Dégradé clair -->
        <LinearGradientBrush x:Key="GradientBg" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F0F8FF" Offset="0"/>
            <GradientStop Color="#D6E9FF" Offset="1"/>
        </LinearGradientBrush>

        <DropShadowEffect x:Key="SoftShadow" Color="#000000"
                          BlurRadius="18" ShadowDepth="0" Opacity="0.25"/>

        <!-- TextBox arrondie avec watermark -->
        <Style TargetType="TextBox" x:Key="RoundedTextBox">
            <Setter Property="Foreground" Value="#003366"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <Border Background="#FFFFFFFF" CornerRadius="8"
                                    BorderBrush="#88AADD" BorderThickness="1" Padding="10"/>
                            <ScrollViewer x:Name="PART_ContentHost"/>
                            <TextBlock x:Name="Watermark"
                                       Text="{TemplateBinding Tag}"
                                       Foreground="#8899AA"
                                       Margin="14,0,0,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Watermark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- PasswordBox arrondie -->
        <Style TargetType="PasswordBox" x:Key="RoundedPasswordBox">
            <Setter Property="Foreground" Value="#003366"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Grid>
                            <Border Background="#FFFFFFFF" CornerRadius="8"
                                    BorderBrush="#88AADD" BorderThickness="1" Padding="10"/>
                            <ScrollViewer x:Name="PART_ContentHost"/>
                            <TextBlock x:Name="Watermark"
                                       Text="{TemplateBinding Tag}"
                                       Foreground="#8899AA"
                                       Margin="14,0,0,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Visibility="Visible"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Watermark" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Bouton principal -->
        <Style TargetType="Button" x:Key="PrimaryButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="10" Background="#3A8DFF" Padding="10,5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1E70E8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Animation d'entrée -->
        <Storyboard x:Key="EnterStoryboard">
            <DoubleAnimation Storyboard.TargetName="Card"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.4"/>
            <DoubleAnimation Storyboard.TargetName="CardTranslate"
                             Storyboard.TargetProperty="Y"
                             From="15" To="0" Duration="0:0:0.4"/>
        </Storyboard>
    </Page.Resources>

    <Grid Background="{StaticResource GradientBg}">
        <Border x:Name="Card"
                Width="600"
                Padding="30"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                CornerRadius="16"
                Background="White"
                Effect="{StaticResource SoftShadow}"
                Opacity="0"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <TranslateTransform x:Name="CardTranslate" Y="15"/>
            </Border.RenderTransform>

            <StackPanel>
                <TextBlock Text="👤 Création d’un utilisateur"
                           FontSize="22" FontWeight="Bold" Foreground="#003366"
                           Margin="0,0,0,20"/>

                <TextBox Style="{StaticResource RoundedTextBox}"
                         Text="{Binding NouvelUtilisateur.Nom, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Tag="Nom"/>

                <TextBox Style="{StaticResource RoundedTextBox}"
                         Text="{Binding NouvelUtilisateur.Prenom, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Tag="Prénom"/>

                <TextBox Style="{StaticResource RoundedTextBox}"
                         Text="{Binding NouvelUtilisateur.Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Tag="Email"/>

                <PasswordBox x:Name="PasswordBox"
                             Style="{StaticResource RoundedPasswordBox}"
                             Tag="Mot de passe"
                             PasswordChanged="PasswordBox_PasswordChanged"/>

                <Button Content="Ajouter l’utilisateur"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding AjouterCommand}"
                        Margin="0,10,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
